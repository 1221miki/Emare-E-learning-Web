PORT=5000
NODE_ENV=development

# Use Atlas for persistence. Set to 'true' to force local in-memory DB fallback.
# This is useful while Atlas connection is being fixed.
USE_IN_MEMORY_DB=false

# ================================
# DATABASE CONFIGURATION
# ================================
# IMPORTANT: Always include the database name "emare" in the URI (before the ?)
# Without it MongoDB defaults to "test" which splits your data across two databases.
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/emare?retryWrites=true&w=majority&appName=AppName
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/emare?retryWrites=true&w=majority&appName=AppName

# ================================
# JWT AUTHENTICATION
# ================================
JWT_SECRET=emare_elms_super_secret_jwt_key_2024_change_in_production
JWT_EXPIRE=120m

