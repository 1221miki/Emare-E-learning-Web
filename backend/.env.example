# ================================
# AI / LLM CONFIGURATION
# ================================
# Set provider to 'gemini' to use Google Gemini APIs
AI_PROVIDER=gemini
# Add your Gemini API key here (keep secret)
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-flash-latest

# ================================
# GOOGLE MEET / CALENDAR OAUTH (REAL Google Meet API)
# ================================
# Enable the Google Meet API in Google Cloud, create an OAuth 2.0 Client ID
# (Web application) and set GOOGLE_REDIRECT_URI to your backend callback:
#   <backend-base>/api/calendar/google/callback
# Then run the "Connect Google Meet" flow in Calendar Management — the refresh
# token is stored server-side (backend/.google-oauth.json, gitignored) and can
# also be provided via GOOGLE_REFRESH_TOKEN after an offline exchange.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_REFRESH_TOKEN=

# ================================
# ZOOM (Server-to-Server OAuth app)
# ================================
# Create a Server-to-Server OAuth app in the Zoom App Marketplace.
# When these are set, live sessions can auto-generate real Zoom meetings;
# otherwise instructors are asked to paste their Zoom invitation link manually.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Optional: specific user to create meetings for (defaults to "me")
ZOOM_USER_ID=

