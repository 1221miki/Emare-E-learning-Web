{
  "name": "emare-elms-client",
  "version": "1.0.0",
  "description": "React Frontend for the Emare E-Learning Management System",
  "private": true,
  "scripts": {
    "dev": "vite",
    "start": "vite --port 5173 --strictPort",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:changed": "eslint src/components/dashboard/tabs src/pages/student/StudentDashboard.jsx src/pages/MessageInboxPage.jsx src/services/api.jsx",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "dependencies": {
    "@babel/parser": "^8.0.4",
    "@tailwindcss/forms": "^0.5.11",
    "axios": "^1.6.8",
    "lucide-react": "^0.469.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.7.0",
    "react-is": "^19.2.8",
    "react-qr-code": "^2.1.0",
    "react-router-dom": "^6.22.3",
    "recharts": "^3.9.2"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "5.0.4",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.25",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.4",
    "vite": "7.3.6",
    "vitest": "^3.2.7"
  }
}
