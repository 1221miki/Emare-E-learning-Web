{
  "name": "emare-e-learning-web",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "open:edge": "cmd /d /c \"ping -n 6 127.0.0.1>nul && start microsoft-edge:http://localhost:5173\"",
    "start": "concurrently \"npm --prefix backend run dev\" \"npm --prefix client start\" \"npm run open:edge\"",
    "dev": "concurrently \"npm --prefix backend run dev\" \"npm --prefix client run dev\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:client": "npm --prefix client run dev",
    "build:client": "npm --prefix client run build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "cloudinary": "^2.10.0",
    "exceljs": "^4.4.0",
    "pdfkit": "^0.19.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.1"
  }
}
